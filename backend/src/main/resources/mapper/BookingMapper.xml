<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinanmuseum.mapper.BookingMapper">

    <!-- 基础 CRUD 由 MyBatis-Plus BaseMapper 提供 -->

    <!-- 指定日期时段的预约单数（看板/统计口径：单数） -->
    <select id="selectCountByDateAndSlot" resultType="int">
        SELECT COUNT(*) FROM booking
        WHERE visit_date = #{date}
          AND slot = #{slot}
          AND status = 'ACTIVE'
    </select>

    <select id="selectByCode" resultType="Booking">
        SELECT * FROM booking
        WHERE code = #{code}
    </select>

    <select id="selectByPhone" resultType="Booking">
        SELECT * FROM booking
        WHERE phone = #{phone}
        ORDER BY created_at DESC
    </select>

</mapper>
