<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinanmuseum.mapper.GuideContentMapper">

    <select id="selectByPageKey" resultType="GuideContent">
        SELECT * FROM guide_content
        WHERE page_key = #{pageKey}
    </select>

</mapper>
