<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinanmuseum.mapper.MuseumEventMapper">

    <!-- 已发布活动按类别过滤，按开始时间倒序 -->
    <select id="selectByCategory" resultType="MuseumEvent">
        SELECT * FROM museum_event
        WHERE published = 1
          AND category = #{category}
        ORDER BY start_time DESC
    </select>

</mapper>
