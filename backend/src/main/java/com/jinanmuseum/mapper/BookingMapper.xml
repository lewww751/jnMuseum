<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinanmuseum.mapper.BookingMapper">

    <select id="selectByPhone" resultType="com.jinanmuseum.entity.Booking">
        SELECT * FROM booking WHERE phone = #{phone}
    </select>

    <select id="selectByCode" resultType="com.jinanmuseum.entity.Booking">
        SELECT * FROM booking WHERE code = #{code}
    </select>

    <select id="selectCountByDateAndSlot" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM booking 
        WHERE visit_date = #{date} AND slot = #{slot}
    </select>

    <select id="selectCountByStatus" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM booking WHERE status = #{status}
    </select>

    <select id="selectCountByStatusAndDate" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM booking 
        WHERE status = #{status} AND visit_date = #{date}
    </select>

</mapper>