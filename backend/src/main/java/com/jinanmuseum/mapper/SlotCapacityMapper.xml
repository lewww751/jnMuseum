<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinanmuseum.mapper.SlotCapacityMapper">

    <select id="selectByDateAndSlot" resultType="com.jinanmuseum.entity.SlotCapacity">
        SELECT * FROM slot_capacity 
        WHERE capacity_date = #{date} AND slot = #{slot}
    </select>

</mapper>